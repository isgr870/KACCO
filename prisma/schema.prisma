datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model Article {
  id          String   @id @default(cuid())
  title       String
  category    String
  content     String   @db.Text
  imageUrl    String
  publishedAt DateTime @default(now())
}

model SiteConfig {
  key   String @id
  value String @db.Text
}
